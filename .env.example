# ---------------------------------------------------------------- AI (Groq)
# Required for AI features. Server-only: never prefix with NEXT_PUBLIC_.
# Without it, Skycast still works and shows rule-based summaries.
GROQ_API_KEY=
# Optional. Checked against Groq's model list at runtime; if it is not
# available to your key, Skycast falls back to openai/gpt-oss-120b,
# llama-3.3-70b-versatile, openai/gpt-oss-20b or llama-3.1-8b-instant.
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------- Weather providers
# All optional; these are the defaults. None of them need an API key.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
REVERSE_GEOCODING_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
RAINVIEWER_URL=https://api.rainviewer.com/public/weather-maps.json
NWS_ALERTS_URL=https://api.weather.gov/alerts/active
# NWS asks for a User-Agent that identifies your app and a contact.
NWS_USER_AGENT=(Skycast weather app, you@example.com)

# Optional: canonical URL for social previews.
NEXT_PUBLIC_SITE_URL=https://weather-app-six-ochre-71.vercel.app
